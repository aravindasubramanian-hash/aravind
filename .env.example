# --- Moss (https://www.moss.dev) ---
# Sign up at moss.dev to get these. Without them, the app runs on an in-process
# mock retrieval store that mirrors Moss's query interface exactly, so the demo
# works out of the box. Set both to switch to live Moss with zero code changes.
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# --- Decision Agent ---
# AGENT_MODE=scripted (default) uses a deterministic proposer that occasionally
# injects a wrong value on purpose, so the guardrail's catches are visible and
# the demo is reproducible without any API key.
# AGENT_MODE=llm calls a real model (requires one of the keys below).
AGENT_MODE=scripted
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
